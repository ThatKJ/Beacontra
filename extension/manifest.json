{
  "manifest_version": 3,
  "name": "Beacontra Lens — Evidence Desk Companion",
  "version": "1.0.0",
  "description": "Cross-verify marketplace listings against verified brand product reference images.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.amazon.in/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Beacontra Lens"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
